    {
      "parameters": {
        "jsCode": "// Get the question's embedding\nconst questionEmbedding = $('HTTP Request').first().json.body;\n\n// Get the 5 policy chunks with their embeddings\nconst chunks = items[0].json.data[0].chunks;\n\n// Cosine similarity function\nfunction cosineSimilarity(a, b) {\n  let dotProduct = 0, magA = 0, magB = 0;\n  for (let i = 0; i < a.length; i++) {\n    dotProduct += a[i] * b[i];\n    magA += a[i] * a[i];\n    magB += b[i] * b[i];\n  }\n  return dotProduct / (Math.sqrt(magA) * Math.sqrt(magB));\n}\n\n// Compare question against every chunk\nconst scored = chunks.map(chunk => ({\n  topic: chunk.topic,\n  text: chunk.text,\n  score: cosineSimilarity(questionEmbedding, chunk.embedding)\n}));\n\n// Sort by highest similarity first\nscored.sort((a, b) => b.score - a.score);\n\nreturn [{\n  json: {\n    question: $('Webhook').first().json.body.question,\n    bestMatch: scored[0],\n    allScores: scored\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1088,
        -1168
      ],
      "id": "7c8a4c60-bb35-4b1f-8902-2914579ecfb7",
      "name": "Code in JavaScript(does cosine similarity)"
    },
    {
      "parameters": {
        "jsCode": "const question = items[0].json.question;\nconst context = items[0].json.bestMatch.text;\n\nconst prompt = `Answer the employee's question using ONLY the context below. If the answer isn't fully in the context, say \"I don't have enough information to answer that.\"\n\nContext: ${context}\n\nQuestion: ${question}`;\n\nreturn [{ json: { prompt } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1536,
        -1264
      ],
      "id": "1f1770dc-1741-4a6f-b5ae-8fd60bc05408",
      "name": "Code in JavaScript1 (builds the Groq prompt)"
    },
    {
      "parameters": {
        "jsCode": "const groqResponse = items[0].json.body;\nconst answerText = groqResponse.choices[0].message.content;\n\nreturn [{\n  json: {\n    answer: answerText,\n    outcome: \"answered\",\n    confidence: $('Code in JavaScript(does cosine similarity)').first().json.bestMatch.score\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1984,
        -1264
      ],
      "id": "9d89a94e-463a-44b4-97a9-0fc1569e331a",
      "name": "Code in JavaScript2(Groq call)"
    },
    {
      "parameters": {
        "jsCode": "const question = items[0].json.question;\nconst bestScore = items[0].json.bestMatch.score;\n\nreturn [{\n  json: {\n    question: question,\n    confidence: bestScore,\n    outcome: \"escalated\"\n  }\n}];"
      },
